[Unit]
Description=CCTV Vehicle Traffic Detection System
After=network.target docker.service influxdb.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=muqsith
Group=muqsith
WorkingDirectory=%h/pengmas/cctv-vehicle-traffic-detetction
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="MPLCONFIGDIR=/tmp/matplotlib-cache"

# Load environment variables from .env file
EnvironmentFile=%h/pengmas/cctv-vehicle-traffic-detetction/.env

# Run the application with venv
ExecStart=%h/pengmas/cctv-vehicle-traffic-detetction/.venv/bin/python -m src.main

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vehicle-detection

[Install]
WantedBy=multi-user.target
